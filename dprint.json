{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "markdown": {
    "lineWidth": 80,
    "textWrap": "maintain"
  },
  "includes": [
    "**/*.md"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/__pycache__"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm"
  ]
}
