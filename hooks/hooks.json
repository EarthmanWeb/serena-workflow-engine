{
  "description": "SWE v5 - state-machine workflow (readAdvance forward-advances on WF_* reads; explicit set_state remains the only backward/pivot driver) with failure tracking, session lifecycle, and metadata injection",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/session/swe_session_start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/prompt/swe_user_prompt_workflow.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/prompt/swe_prompt_format_reminder.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_tool_init_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_memory_fs_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|mcp__plugin_swe_serena__replace_symbol_body|mcp__plugin_swe_serena__replace_content|mcp__plugin_swe_serena__insert_before_symbol|mcp__plugin_swe_serena__insert_after_symbol|mcp__plugin_swe_serena__create_text_file|mcp__plugin_swe_serena__replace_lines|mcp__plugin_swe_serena__delete_lines|mcp__plugin_swe_serena__insert_at_line|mcp__plugin_swe_serena__replace_in_files|mcp__serena__replace_symbol_body|mcp__serena__replace_content|mcp__serena__insert_before_symbol|mcp__serena__insert_after_symbol|mcp__serena__create_text_file|mcp__serena__replace_lines|mcp__serena__delete_lines|mcp__serena__insert_at_line|mcp__serena__replace_in_files",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_edit_validate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|mcp__plugin_swe_serena__write_memory|mcp__plugin_swe_serena__edit_memory|mcp__serena__write_memory|mcp__serena__edit_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_memory_index_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_bash_test_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash|mcp__plugin_swe_serena__search_for_pattern|mcp__serena__search_for_pattern",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_search_docs_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_question_consent_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/pre/swe_pre_agent_model_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__serena__read_memory|mcp__plugin_swe_serena__read_memory|mcp__serena__list_memories|mcp__plugin_swe_serena__list_memories|mcp__serena__search_memories_by_name|mcp__plugin_swe_serena__search_memories_by_name|mcp__serena__search_memories_by_front_matter|mcp__plugin_swe_serena__search_memories_by_front_matter",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_read_state.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|mcp__plugin_swe_serena__replace_symbol_body|mcp__plugin_swe_serena__replace_content|mcp__plugin_swe_serena__insert_before_symbol|mcp__plugin_swe_serena__insert_after_symbol|mcp__serena__replace_symbol_body|mcp__serena__replace_content|mcp__serena__insert_before_symbol|mcp__serena__insert_after_symbol",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_edit_checkpoint.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__serena__write_memory|mcp__plugin_swe_serena__write_memory|mcp__serena__edit_memory|mcp__plugin_swe_serena__edit_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_write_continue.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__serena__write_memory|mcp__plugin_swe_serena__write_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_memory_index.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__serena__write_memory|mcp__plugin_swe_serena__write_memory|mcp__serena__edit_memory|mcp__plugin_swe_serena__edit_memory",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_memory_style.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_todo_wm_sync.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob|mcp__plugin_swe_serena__search_for_pattern|mcp__serena__search_for_pattern",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_search_docs_hint.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_doc_claims.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|Agent|Task|Workflow|SendMessage|mcp__plugin_swe_serena__replace_symbol_body|mcp__plugin_swe_serena__replace_content|mcp__plugin_swe_serena__insert_before_symbol|mcp__plugin_swe_serena__insert_after_symbol|mcp__serena__replace_symbol_body|mcp__serena__replace_content|mcp__serena__insert_before_symbol|mcp__serena__insert_after_symbol",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_orchestrator_drift.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/stop/swe_stop_continue_working.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/stop/swe_stop_response_format.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/session/swe_session_end.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/post/swe_post_tool_failure.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
