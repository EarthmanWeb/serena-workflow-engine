{
	"description": "Serena Workflow Engine - 21-state workflow with RLVR learning",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_session_start.py",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_user_prompt_workflow.py",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_user_prompt_swarm.py",
						"timeout": 10
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_pre_tool_init_gate.py",
						"timeout": 5000
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude_flow_pre_bash.py",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_pre_bash_test_gate.py",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Write|Edit|MultiEdit|mcp__serena__replace_symbol_body|mcp__serena__insert_after_symbol|mcp__serena__insert_before_symbol",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_pre_edit_validate.py",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude_flow_pre_edit.py",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "mcp__playwright__browser_navigate",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_pre_playwright_auth.py",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude_flow_post_bash.py",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Write|Edit|MultiEdit|mcp__serena__replace_symbol_body|mcp__serena__insert_after_symbol|mcp__serena__insert_before_symbol",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_post_edit_checkpoint.py",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/claude_flow_post_edit.py",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "mcp__serena__read_memory",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_post_read_state.py",
						"timeout": 10
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_post_task_learn.py",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/swe_stop_workflow_check.py",
						"timeout": 10
					}
				]
			}
		]
	}
}
