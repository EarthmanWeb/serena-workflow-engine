{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "description": "Serena Workflow Engine - 17 State Machine with Stream-Based Enforcement",

  "complexityThresholds": {
    "simple": { "files": [1, 2], "layers": 1, "expectedTransitions": 8 },
    "medium": { "files": [2, 5], "layers": [2, 3], "expectedTransitions": 12 },
    "large": { "files": [6, 999], "layers": [3, 999], "expectedTransitions": 18 }
  },

  "states": {
    "WF_INITIAL_SETUP": {
      "id": "WF_INITIAL_SETUP",
      "category": "setup",
      "icon": "🔧",
      "description": "First-time plugin setup - install MCPs, configure environment",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "complete": "WF_START", "issues": "WF_CLARIFY" }
    },

    "WF_ONBOARD": {
      "id": "WF_ONBOARD",
      "category": "setup",
      "icon": "📝",
      "description": "Feature onboarding wizard",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": { "complete": "WF_START" }
    },

    "WF_START": {
      "id": "WF_START",
      "category": "entry",
      "icon": "🚀",
      "description": "Mandatory entry point - read context, determine path",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "new_task": "WF_CLASSIFY",
        "continue_task": "WF_CONTINUE",
        "research_only": "WF_RESEARCH",
        "onboard_needed": "WF_ONBOARD"
      }
    },

    "WF_CLASSIFY": {
      "id": "WF_CLASSIFY",
      "category": "entry",
      "icon": "🔍",
      "description": "Classify task complexity and route appropriately",
      "planMode": "conditional",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "simple": "WF_REQUIREMENTS",
        "medium": "WF_PLAN_ARCHITECTURE",
        "large": "WF_SWARM_ORCHESTRATE",
        "research_needed": "WF_RESEARCH",
        "debug_needed": "WF_DEBUG_TDD",
        "needs_clarification": "WF_CLARIFY"
      }
    },

    "WF_CONTINUE": {
      "id": "WF_CONTINUE",
      "category": "entry",
      "icon": "▶️",
      "description": "Resume from existing WORKING_MEMORY",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "arch_review": "WF_ARCH_REVIEW",
        "execute": "WF_EXECUTE",
        "needs_clarification": "WF_CLARIFY",
        "reclassify": "WF_CLASSIFY"
      }
    },

    "WF_RESEARCH": {
      "id": "WF_RESEARCH",
      "category": "analysis",
      "icon": "🔬",
      "description": "Code exploration without changes",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "complete": "WF_REQUIREMENTS" }
    },

    "WF_REQUIREMENTS": {
      "id": "WF_REQUIREMENTS",
      "category": "analysis",
      "icon": "📋",
      "description": "Detect, document, and confirm requirements",
      "planMode": "conditional",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "confirmed": "WF_LOAD_FEATURE",
        "needs_clarification": "WF_CLARIFY"
      }
    },

    "WF_PLAN_ARCHITECTURE": {
      "id": "WF_PLAN_ARCHITECTURE",
      "category": "planning",
      "icon": "🏗️",
      "description": "Design implementation approach for medium+ complexity",
      "planMode": "always",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "approved": "WF_SWARM_ORCHESTRATE",
        "simple_enough": "WF_REQUIREMENTS",
        "needs_revision": "WF_PLAN_ARCHITECTURE",
        "needs_clarification": "WF_CLARIFY"
      }
    },

    "WF_ARCH_REVIEW": {
      "id": "WF_ARCH_REVIEW",
      "category": "planning",
      "icon": "🔎",
      "description": "Review architecture compliance and request permission before execution",
      "planMode": "always",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "approved": "WF_EXECUTE",
        "needs_revision": "WF_PLAN_ARCHITECTURE"
      }
    },

    "WF_SWARM_ORCHESTRATE": {
      "id": "WF_SWARM_ORCHESTRATE",
      "category": "planning",
      "icon": "🐝",
      "description": "Multi-agent swarm coordination for large tasks",
      "planMode": "always",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "complete": "WF_EXECUTE" }
    },

    "WF_CLARIFY": {
      "id": "WF_CLARIFY",
      "category": "gates",
      "icon": "❓",
      "description": "Request clarification from user",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "clarified": "(return_to_caller)" }
    },

    "WF_LOAD_FEATURE": {
      "id": "WF_LOAD_FEATURE",
      "category": "execution",
      "icon": "📦",
      "description": "Load feature context from memories",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "code_changes": "WF_ARCH_REVIEW",
        "operational": "WF_EXECUTE"
      }
    },

    "WF_EXECUTE": {
      "id": "WF_EXECUTE",
      "category": "execution",
      "icon": "⚡",
      "description": "Execute implementation changes",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "checkpoint_needed": "WF_CHECKPOINT",
        "complete": "WF_VERIFY"
      }
    },

    "WF_CHECKPOINT": {
      "id": "WF_CHECKPOINT",
      "category": "execution",
      "icon": "💾",
      "description": "Save progress checkpoint and update working memory",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "continue": "WF_EXECUTE",
        "complete": "WF_VERIFY"
      }
    },

    "WF_DEBUG_TDD": {
      "id": "WF_DEBUG_TDD",
      "category": "execution",
      "icon": "🐛",
      "description": "Test-driven debugging workflow",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "fixed": "WF_EXECUTE",
        "needs_help": "WF_CLARIFY"
      }
    },

    "WF_VERIFY": {
      "id": "WF_VERIFY",
      "category": "completion",
      "icon": "✔️",
      "description": "Verify implementation against requirements",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "passed": "WF_DONE",
        "failed": "WF_EXECUTE"
      }
    },

    "WF_DONE": {
      "id": "WF_DONE",
      "category": "completion",
      "icon": "✅",
      "description": "Task complete - archive and summarize",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "terminal": true,
      "transitions": { "complete": null }
    }
  },

  "transitionMatrix": {
    "SessionStart": ["WF_INITIAL_SETUP", "WF_START"],
    "WF_INITIAL_SETUP": ["WF_START", "WF_CLARIFY"],
    "WF_START": ["WF_CLASSIFY", "WF_CONTINUE", "WF_RESEARCH", "WF_ONBOARD"],
    "WF_CLASSIFY": ["WF_CLARIFY", "WF_RESEARCH", "WF_REQUIREMENTS", "WF_PLAN_ARCHITECTURE", "WF_SWARM_ORCHESTRATE", "WF_DEBUG_TDD"],
    "WF_CONTINUE": ["WF_ARCH_REVIEW", "WF_EXECUTE", "WF_CLARIFY", "WF_CLASSIFY"],
    "WF_RESEARCH": ["WF_REQUIREMENTS"],
    "WF_REQUIREMENTS": ["WF_LOAD_FEATURE", "WF_CLARIFY"],
    "WF_PLAN_ARCHITECTURE": ["WF_SWARM_ORCHESTRATE", "WF_REQUIREMENTS", "WF_CLARIFY"],
    "WF_ARCH_REVIEW": ["WF_EXECUTE", "WF_PLAN_ARCHITECTURE"],
    "WF_SWARM_ORCHESTRATE": ["WF_EXECUTE"],
    "WF_CLARIFY": ["(return_to_caller)"],
    "WF_LOAD_FEATURE": ["WF_ARCH_REVIEW", "WF_EXECUTE"],
    "WF_EXECUTE": ["WF_CHECKPOINT", "WF_VERIFY"],
    "WF_CHECKPOINT": ["WF_EXECUTE", "WF_VERIFY"],
    "WF_DEBUG_TDD": ["WF_EXECUTE", "WF_CLARIFY"],
    "WF_VERIFY": ["WF_DONE", "WF_EXECUTE"],
    "WF_DONE": [null],
    "WF_ONBOARD": ["WF_START"]
  }
}
