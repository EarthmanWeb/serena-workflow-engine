{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "4.0.0",
  "description": "Serena Workflow Engine v4 - read≠transition (reads never advance the FSM), no WF_START hop; init chain routes directly to WF_CLASSIFY",

  "complexityThresholds": {
    "simple": { "files": [1, 2], "layers": 1, "expectedTransitions": 7 },
    "medium": { "files": [2, 5], "layers": [2, 3], "expectedTransitions": 8 },
    "large": { "files": [6, 999], "layers": [3, 999], "expectedTransitions": 10 }
  },

  "states": {
    "WF_INITIAL_SETUP": {
      "id": "WF_INITIAL_SETUP",
      "category": "setup",
      "icon": "🔧",
      "description": "First-time plugin setup - install MCPs, configure environment",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "complete": "WF_CLASSIFY", "issues": "WF_CLARIFY" }
    },

    "WF_ONBOARD": {
      "id": "WF_ONBOARD",
      "category": "setup",
      "icon": "📝",
      "description": "Feature onboarding wizard",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": { "complete": "WF_CLASSIFY", "swarm_needed": "WF_SWARM_ORCHESTRATE", "classify": "WF_CLASSIFY" }
    },

    "WF_CLASSIFY": {
      "id": "WF_CLASSIFY",
      "category": "entry",
      "icon": "🔍",
      "description": "Classify task, detect requirements, load features, validate & route",
      "planMode": "conditional",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "code_changes": "WF_ARCH_REVIEW",
        "minor_patch": "WF_EXECUTE",
        "operational": "WF_EXECUTE",
        "research_needed": "WF_RESEARCH",
        "debug_needed": "WF_DEBUG_TDD",
        "needs_clarification": "WF_CLARIFY"
      }
    },

    "WF_CONTINUE": {
      "id": "WF_CONTINUE",
      "category": "entry",
      "icon": "▶️",
      "description": "Resume from existing WORKING_MEMORY",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "arch_review": "WF_ARCH_REVIEW",
        "execute": "WF_EXECUTE",
        "needs_clarification": "WF_CLARIFY",
        "reclassify": "WF_CLASSIFY"
      }
    },

    "WF_RESEARCH": {
      "id": "WF_RESEARCH",
      "category": "analysis",
      "icon": "🔬",
      "description": "Code exploration without changes",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "needs_implementation": "WF_CLASSIFY",
        "complete": "WF_DONE"
      }
    },

    "WF_ARCH_REVIEW": {
      "id": "WF_ARCH_REVIEW",
      "category": "planning",
      "icon": "🔎",
      "description": "Design implementation, review architecture compliance, assess swarm need, get approval",
      "planMode": "always",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "approved": "WF_EXECUTE",
        "swarm_needed": "WF_SWARM_ORCHESTRATE",
        "needs_revision": "WF_ARCH_REVIEW",
        "needs_clarification": "WF_CLARIFY"
      }
    },

    "WF_SWARM_ORCHESTRATE": {
      "id": "WF_SWARM_ORCHESTRATE",
      "category": "planning",
      "icon": "🐝",
      "description": "Multi-agent swarm coordination for large tasks",
      "planMode": "always",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": {
        "complete": "WF_EXECUTE",
        "simpler_approach": "WF_ARCH_REVIEW"
      }
    },

    "WF_CLARIFY": {
      "id": "WF_CLARIFY",
      "category": "gates",
      "icon": "❓",
      "description": "Request clarification from user",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "transitions": { "clarified": "(return_to_caller)" }
    },

    "WF_EXECUTE": {
      "id": "WF_EXECUTE",
      "category": "execution",
      "icon": "⚡",
      "description": "Execute implementation changes",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "checkpoint_needed": "WF_CHECKPOINT",
        "complete": "WF_VERIFY"
      }
    },

    "WF_CHECKPOINT": {
      "id": "WF_CHECKPOINT",
      "category": "execution",
      "icon": "💾",
      "description": "Save progress checkpoint and update working memory",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "continue": "WF_EXECUTE",
        "complete": "WF_VERIFY"
      }
    },

    "WF_DEBUG_TDD": {
      "id": "WF_DEBUG_TDD",
      "category": "execution",
      "icon": "🐛",
      "description": "Test-driven debugging workflow",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "fixed": "WF_EXECUTE",
        "needs_help": "WF_CLARIFY"
      }
    },

    "WF_VERIFY": {
      "id": "WF_VERIFY",
      "category": "completion",
      "icon": "✔️",
      "description": "Verify implementation against requirements",
      "planMode": "never",
      "allowEdit": true,
      "allowWrite": true,
      "transitions": {
        "passed": "WF_DONE",
        "failed": "WF_EXECUTE",
        "re_scope": "WF_CLASSIFY"
      }
    },

    "WF_DONE": {
      "id": "WF_DONE",
      "category": "completion",
      "icon": "✅",
      "description": "Task complete - archive and summarize",
      "planMode": "never",
      "allowEdit": false,
      "allowWrite": false,
      "terminal": true,
      "transitions": { "new_task": "WF_CLASSIFY", "new_session": "WF_CLASSIFY" }
    }
  },

  "transitionMatrix": {
    "SessionStart": ["WF_INITIAL_SETUP", "WF_CLASSIFY"],
    "WF_INITIAL_SETUP": ["WF_CLASSIFY", "WF_CLARIFY"],
    "WF_CLASSIFY": ["WF_ARCH_REVIEW", "WF_EXECUTE", "WF_RESEARCH", "WF_DEBUG_TDD", "WF_CLARIFY"],
    "WF_CONTINUE": ["WF_ARCH_REVIEW", "WF_EXECUTE", "WF_CLARIFY", "WF_CLASSIFY"],
    "WF_RESEARCH": ["WF_CLASSIFY", "WF_DONE"],
    "WF_ARCH_REVIEW": ["WF_EXECUTE", "WF_SWARM_ORCHESTRATE", "WF_ARCH_REVIEW", "WF_CLARIFY"],
    "WF_SWARM_ORCHESTRATE": ["WF_EXECUTE", "WF_ARCH_REVIEW"],
    "WF_CLARIFY": ["(return_to_caller)"],

    "WF_EXECUTE": ["WF_CHECKPOINT", "WF_VERIFY"],
    "WF_CHECKPOINT": ["WF_EXECUTE", "WF_VERIFY"],
    "WF_DEBUG_TDD": ["WF_EXECUTE", "WF_CLARIFY"],
    "WF_VERIFY": ["WF_DONE", "WF_EXECUTE", "WF_CLASSIFY"],
    "WF_DONE": ["WF_CLASSIFY", "WF_INIT"],
    "WF_ONBOARD": ["WF_SWARM_ORCHESTRATE", "WF_CLASSIFY"]
  }
}
