#!/bin/bash
# Git pre-commit hook for SWE plugin
# Automatically bumps version on each commit

# Get the plugin root (where the submodule actually lives)
PLUGIN_ROOT="$(git rev-parse --show-toplevel)"
BUMP_SCRIPT="$PLUGIN_ROOT/scripts/bump-version.sh"

if [[ ! -f "$BUMP_SCRIPT" ]]; then
    echo "Warning: bump-version.sh not found at $BUMP_SCRIPT"
    exit 0
fi

# Run the bump script
"$BUMP_SCRIPT"

# Sync version into .mcp.json memory-path
NEW_VERSION=$(python3 -c "import json; print(json.load(open('$PLUGIN_ROOT/.claude-plugin/plugin.json'))['version'])")
MCP_JSON="$PLUGIN_ROOT/.mcp.json"
if [[ -f "$MCP_JSON" ]]; then
    sed -i '' "s|cache/EarthmanWeb/swe/[0-9][0-9.]*[0-9]/memories|cache/EarthmanWeb/swe/$NEW_VERSION/memories|g" "$MCP_JSON"
fi

# Stage the bumped files
git add "$PLUGIN_ROOT/.claude-plugin/plugin.json" "$PLUGIN_ROOT/.claude-plugin/marketplace.json" "$MCP_JSON"
[[ -f "$PLUGIN_ROOT/package.json" ]] && git add "$PLUGIN_ROOT/package.json"
