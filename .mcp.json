{
  "mcpServers": {
    "serena-em": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/EarthmanWeb/serena@feature-multiplefoldersupport",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "./",
        "--additional-folders",
        ".serena/memories/wf",
        "--enable-web-dashboard=false"
      ],
      "env": {}
    }
  }
}
